# Token Plan：仅用于本人在 localhost 上进行交互式研究
# DASHSCOPE_API_KEY=sk-sp-请替换为你的TokenPlan密钥
# DASHSCOPE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
# qwen3.8-max supports up to 131072 output tokens. Thinking tokens are included.
QWEN_MAX_OUTPUT_TOKENS=65536
RESEARCH_TOTAL_TIMEOUT_MINUTES=60
RESEARCH_INACTIVITY_TIMEOUT_MINUTES=5

# 若改用按量付费，请同时替换普通 sk- 密钥与通用 Base URL：
DASHSCOPE_API_KEY=sk-请替换为你的普通百炼APIKey
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
